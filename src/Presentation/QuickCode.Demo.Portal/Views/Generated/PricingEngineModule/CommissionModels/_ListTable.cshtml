@using QuickCode.Demo.Portal.Models.PricingEngineModule
@model PricingEngineModule.CommissionModelData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in PricingEngineModule.CommissionModel table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    <vc:operation-buttons item-id="Header" controller-name="" action-name=""></vc:operation-buttons>
                    <th class="portal-col" data-col-type="id" data-col-key="Id">Id</th>
<th class="portal-col" data-col-type="text" data-col-key="Name">Name</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsActive">Is Active</th>
<th class="portal-col" data-col-type="large" data-col-key="Description">Description</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        <vc:operation-buttons item-id=@item.GetKey() controller-name="" action-name=""></vc:operation-buttons>
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="text" data-col-key="Name">@item.Name</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsActive">@if (item.IsActive == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" disabled />
    </div>
}
</td>
<td class="portal-col" data-col-type="large" data-col-key="Description">@item.Description</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
