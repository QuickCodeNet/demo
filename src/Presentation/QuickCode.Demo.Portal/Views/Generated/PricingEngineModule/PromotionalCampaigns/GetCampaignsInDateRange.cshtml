@model QuickCode.Demo.Portal.Models.PricingEngineModule.PromotionalCampaignGetCampaignsInDateRangeData
@{
    string title = "GetCampaignsInDateRange".SplitCamelCaseToString();
    TempData["Title"] = title;
}
<div class="container-fluid portal-query-page" IsPageAvailable="true">
    <form method="post" id="formList" data-portal-query="true" class="portal-entity-form portal-query-form" data-list-partial-url="/PricingEngineModulePromotionalCampaigns/Queries/GetCampaignsInDateRangePartial">
        @Html.AntiForgeryToken()
        <div class="portal-query-shell">
            <header class="portal-query-header">
                <div class="portal-query-header__copy">
                    <p class="portal-query-kicker">Query</p>
                    <h2 class="portal-query-title">@title</h2>
                    <p class="portal-query-lead">Set the filters, run once, then scan the rows below.</p>
                </div>
                <div class="portal-query-endpoint" title="API endpoint used by this query">
                    <span class="portal-query-endpoint__method">GET</span>
                    <code class="portal-query-endpoint__path">/api/pricing-engine-module/promotional-campaigns/get-campaigns-in-date-range/{promotionalCampaignStartDateFrom}/{promotionalCampaignStartDateTo}?pageNumber={pageNumber}&pageSize={pageSize}</code>
                </div>
            </header>

            <section class="portal-query-workspace" aria-label="Query parameters">
                <div class="portal-query-toolbar">
                    <div class="portal-query-params portal-entity-form">
<div class="form-group row">
    <label class="col-form-label col-sm-4" for="PromotionalCampaignStartDateFrom">Promotional Campaign Start Date From</label>
    <div class="col-sm-8">
        <div class="input-group flatpickr flatpickr-datetime" id="fp_PromotionalCampaignStartDateFrom">
            <!input id="PromotionalCampaignStartDateFrom" name="PromotionalCampaignStartDateFrom" class="form-control portal-datetime-input" type="text" data-input autocomplete="off" placeholder="dd.MM.yyyy HH:mm"
                value="@(Model.PromotionalCampaignStartDateFrom == null ? string.Empty : (Convert.ToDateTime(Model.PromotionalCampaignStartDateFrom).Year > 1 ? Convert.ToDateTime(Model.PromotionalCampaignStartDateFrom).ToString("dd.MM.yyyy HH:mm") : string.Empty))" />
            <!button class="input-group-text portal-datetime-toggle" type="button" data-toggle title="Select date" tabindex="-1" aria-label="Select date">
                <i class="fa fa-calendar" aria-hidden="true"></i>
            </!button>
        </div>
    </div>
</div>

<div class="form-group row">
    <label class="col-form-label col-sm-4" for="PromotionalCampaignStartDateTo">Promotional Campaign Start Date To</label>
    <div class="col-sm-8">
        <div class="input-group flatpickr flatpickr-datetime" id="fp_PromotionalCampaignStartDateTo">
            <!input id="PromotionalCampaignStartDateTo" name="PromotionalCampaignStartDateTo" class="form-control portal-datetime-input" type="text" data-input autocomplete="off" placeholder="dd.MM.yyyy HH:mm"
                value="@(Model.PromotionalCampaignStartDateTo == null ? string.Empty : (Convert.ToDateTime(Model.PromotionalCampaignStartDateTo).Year > 1 ? Convert.ToDateTime(Model.PromotionalCampaignStartDateTo).ToString("dd.MM.yyyy HH:mm") : string.Empty))" />
            <!button class="input-group-text portal-datetime-toggle" type="button" data-toggle title="Select date" tabindex="-1" aria-label="Select date">
                <i class="fa fa-calendar" aria-hidden="true"></i>
            </!button>
        </div>
    </div>
</div>
                    </div>
                    <div class="portal-query-actions">
                        <button type="submit" class="portal-query-run">
                            <i class="fas fa-play" aria-hidden="true"></i>
                            <span>Run Query</span>
                        </button>
                    </div>
                </div>
            </section>

            <section id="list-region" class="portal-list-region portal-query-results" aria-label="Query results">
                @await Html.PartialAsync("_GetCampaignsInDateRangeTable", Model)
            </section>
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="HasRun" />
    </form>
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>
