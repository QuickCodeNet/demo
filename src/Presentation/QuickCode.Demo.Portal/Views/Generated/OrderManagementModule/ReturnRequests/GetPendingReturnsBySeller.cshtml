@model QuickCode.Demo.Portal.Models.OrderManagementModule.ReturnRequestGetPendingReturnsBySellerData
@{
    string title = "GetPendingReturnsBySeller".SplitCamelCaseToString();
    TempData["Title"] = title;
}
<div class="container-fluid portal-query-page" IsPageAvailable="true">
    <form method="post" id="formList" data-portal-query="true" class="portal-entity-form portal-query-form" data-list-partial-url="/OrderManagementModuleReturnRequests/Queries/GetPendingReturnsBySellerPartial">
        @Html.AntiForgeryToken()
        <div class="portal-query-shell">
            <header class="portal-query-header">
                <div class="portal-query-header__copy">
                    <p class="portal-query-kicker">Query</p>
                    <h2 class="portal-query-title">@title</h2>
                    <p class="portal-query-lead">Set the filters, run once, then scan the rows below.</p>
                </div>
                <div class="portal-query-endpoint" title="API endpoint used by this query">
                    <span class="portal-query-endpoint__method">GET</span>
                    <code class="portal-query-endpoint__path">/api/order-management-module/return-requests/get-pending-returns-by-seller/{ordersSellerId}?pageNumber={pageNumber}&pageSize={pageSize}</code>
                </div>
            </header>

            <section class="portal-query-workspace" aria-label="Query parameters">
                <div class="portal-query-toolbar">
                    <div class="portal-query-params portal-entity-form">
<form-group>
	<input asp-for="OrdersSellerId" placeholder="Enter your Orders Seller Id" bc-label="Orders Seller Id" type="Text"  bc-required="true" bc-tooltip="Enter your Orders Seller Id" bc-validation="true" />
</form-group>
                    </div>
                    <div class="portal-query-actions">
                        <button type="submit" class="portal-query-run">
                            <i class="fas fa-play" aria-hidden="true"></i>
                            <span>Run Query</span>
                        </button>
                    </div>
                </div>
            </section>

            <section id="list-region" class="portal-list-region portal-query-results" aria-label="Query results">
                @await Html.PartialAsync("_GetPendingReturnsBySellerTable", Model)
            </section>
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="HasRun" />
    </form>
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>
