@using QuickCode.Demo.Portal.Models.ProductCatalogModule
@model ProductCatalogModule.ProductData
<div class="modal-content portal-entity-modal" data-operation="Update">
    <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Product Update Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
        </button>
    </div>
    <div class="modal-body">
     <div class="card" IsPageAvailable="true">
        <div class="card-body">
            <form bc-label-width-sm="4" bc-horizontal="true" id="formUpdate" action="Update" method="post" class="needs-validation portal-entity-form" bc-validation="true">
                @Html.AntiForgeryToken()
                <form-group>
	<input type="text" bc-label="Id" asp-for="SelectedItem.Id" bc-static="true" />
</form-group>

<form-group>
	<input asp-for="SelectedItem.SellerId" placeholder="Enter your SellerId" bc-label="Seller Id" type="Text"  bc-required="true" bc-tooltip="Enter your SellerId" bc-validation="true" />
</form-group>

<form-group>
	<select bc-label="Brand Id" class="form-select searchable-select" asp-for="SelectedItem.BrandId" asp-items="@Model.GetComboBoxList("Brands", Model.SelectedItem.BrandId)"  data-placeholder="Search for BrandId..."></select>
</form-group>

<form-group>
	<select bc-label="Primary Category Id" class="form-select searchable-select" asp-for="SelectedItem.PrimaryCategoryId" asp-items="@Model.GetComboBoxList("Categories", Model.SelectedItem.PrimaryCategoryId)"  data-placeholder="Search for PrimaryCategoryId..."></select>
</form-group>

<form-group>
	<input asp-for="SelectedItem.Sku" placeholder="Enter your Sku" bc-label="Sku" type="Text"  bc-required="true" bc-tooltip="Enter your Sku" bc-validation="true" />
</form-group>

<form-group>
	<input asp-for="SelectedItem.Name" placeholder="Enter your Name" bc-label="Name" type="Text"  bc-required="true" bc-tooltip="Enter your Name" bc-validation="true" />
</form-group>

<form-group>
	<input asp-for="SelectedItem.Description" placeholder="Enter your Description" bc-label="Description" type="Text"  bc-required="true" bc-tooltip="Enter your Description" bc-validation="true" />
</form-group>

<form-group>
    <label class="col-sm-4 col-form-label">Photo</label>
    <span class="col-sm-8">
         <a href="@(Model.SelectedItem.Photo == null || Model.SelectedItem.Photo.Length == 0 ? "/images/no_image.png" : Model.SelectedItem.Photo)" data-toggle="lightbox" data-type="image" >
             <img id = 'SelectedItem_PhotoImg' class="lazyload" src="/images/loading.svg" data-src="@(Model.SelectedItem.Photo == null || Model.SelectedItem.Photo.Length == 0 ? "/images/no_image.png" : Model.SelectedItem.Photo)" style="height:auto;  width:auto; max-height: 250px; max-width: 350px; margin-bottom: -10px; margin-top: 0px; display: block;margin-right: auto;" bc-thumbnail="true" bc-round="true" />
         </a>
    </span>
 </form-group>
 <form-group>
     <input asp-for="SelectedItem.Photo" placeholder="Enter your SelectedItem.Photo" class="opButtonImageUpload" type="file" accept="image/*" data-max-bytes="5242880"   bc-label=" " bc-tooltip="Enter your SelectedItem.Photo"  />
     <help class="text-muted small mt-1">Max size: 5 MB</help>
</form-group>


<form-group>
    <label class="col-sm-4 col-form-label">Video</label>
    <span class="col-sm-8">
        @if (!string.IsNullOrEmpty(Model.SelectedItem.Video))
        {
            <span class="portal-blob-pdf-card">
                <a href="@Model.SelectedItem.Video" data-toggle="lightbox" data-type="video" class="btn btn-sm btn-outline-primary">Preview video</a>
                <a href="@Model.SelectedItem.Video" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Open video</a>
            </span>
            <span class="text-muted small mt-1 text-break d-block">@Model.SelectedItem.Video</span>
        }
        else
        {
            <span class="text-muted">No file</span>
        }
    </span>
</form-group>
<form-group>
    <input asp-for="SelectedItem.Video" placeholder="Enter your SelectedItem.Video" class="opButtonImageUpload" type="file" accept="video/*" data-max-bytes="20971520"  bc-label=" " bc-tooltip="Enter your SelectedItem.Video"  />
    <help class="text-muted small mt-1">Max size: 20 MB</help>
</form-group>


<form-group>
    <label class="col-sm-4 col-form-label">Datasheet</label>
    <span class="col-sm-8">
        @if (!string.IsNullOrEmpty(Model.SelectedItem.Datasheet))
        {
            <span class="portal-blob-pdf-card">
                <a href="@Model.SelectedItem.Datasheet" data-toggle="lightbox" data-type="pdf" class="btn btn-sm btn-outline-primary">Preview PDF</a>
                <a href="@Model.SelectedItem.Datasheet" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Open PDF</a>
            </span>
            <span class="text-muted small mt-1 text-break d-block">@Model.SelectedItem.Datasheet</span>
        }
        else
        {
            <span class="text-muted">No file</span>
        }
    </span>
</form-group>
<form-group>
    <input asp-for="SelectedItem.Datasheet" placeholder="Enter your SelectedItem.Datasheet" class="opButtonImageUpload" type="file" accept=".pdf,application/pdf" data-max-bytes="10485760"  bc-label=" " bc-tooltip="Enter your SelectedItem.Datasheet"  />
    <help class="text-muted small mt-1">Max size: 10 MB</help>
</form-group>


<form-group>
	<select bc-label="Status" class="form-select searchable-select" asp-for="SelectedItem.Status" asp-items="Html.GetEnumSelectList<ProductCatalogModuleApi.ProductStatus>()" data-placeholder="Search for Status..."></select>
</form-group>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label" for="SelectedItem.IsFeatured">Is Featured</label>
        <div class="col-sm-8">
            <div class="input-group">
                @Html.HiddenFor(m => m.SelectedItem.IsFeatured)
                @if (Model.SelectedItem.IsFeatured == true)
                {
                    <div class="ios-switch-wrapper checked">
                        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_SelectedItem_IsFeatured" checked />
                    </div>
                }
                else
                {
                    <div class="ios-switch-wrapper">
                        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_SelectedItem_IsFeatured" />
                    </div>
                }
            </div>
        </div>
    </div>

<div class="form-group row">
    <label class="col-sm-4 col-form-label" for="SelectedItem_CreatedDate">Created Date</label>
    <div class="col-sm-8">
        <input type="text" class="form-control portal-datetime-readonly" id="SelectedItem_CreatedDate" readonly
            value="@(Model.SelectedItem.CreatedDate is DateTime SelectedItem_CreatedDate_dt && SelectedItem_CreatedDate_dt.Year > 1 ? SelectedItem_CreatedDate_dt.ToString("dd.MM.yyyy HH:mm") : string.Empty)" />
    </div>
</div>


                <div id="actionResultDiv">
                    <h5 id="actionResultMessage">
                        Text Result
                    </h5>
                </div>
                <div class="portal-entity-footer">
                    <div class="portal-entity-actions">
                 <button type="button" data-bs-dismiss="modal" class="btn btn-portal-secondary" bc-color="Secondary">Cancel</button>
<button type="reset" class="btn btn-portal-ghost" bc-outline="true" bc-color="Info">Clear</button>
<button type="submit" formmethod="post" formaction="/ProductCatalogModuleProducts/Update" class="btn btn-portal-primary" bc-color="Primary">Update</button>

                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card" IsPageAvailable="false">
        @await Html.PartialAsync("_NotAuthorized")
    </div>
</div>
</div>
<script src="/js/bootstrap-toggle.js"></script>
<script>
        var fileData = {};
        $('.textarea-editor').summernote(
        {
            height: 200
        });
       
        window.addEventListener('load', (event) => {
            init();
        });

        $("img.lazyload").lazyload();

        function checkBoxChanged(cbox) {
            console.log('Changed ' + cbox.id);
            console.log('Changed ' + cbox.checked);
            var itemId = cbox.id.replace("cbox_", "").replace(".", "_");
            $("#" + itemId).val(cbox.checked);
        }

        $('.opButtonImageUpload').change(function (e) {
            var formData = new FormData($("#formUpdate")[0]);
            var reader = new FileReader();
            var imageId = '#' + this.id + 'Img';
            var realImageId = '' + this.id;
            imageId = imageId.replace('.', '_');
            
            reader.onload = function (event) {
              var image = new Image();
          
              image.onload=function(){
                  var imageMaxSize=1200;
                  var fileType = this.src.split(';')[0].split(':')[1];
                  
                  if(fileType.split('/').length>1 && fileType.split('/')[1] != 'gif'){
                      var canvas = document.createElement('canvas'),
                          max_size = imageMaxSize,// TODO : pull max size from a site config
                          width = image.width,
                          height = image.height;
                      if (width > height) {
                          if (width > max_size) {
                              height *= max_size / width;
                              width = max_size;
                          }
                      } else {
                          if (height > max_size) {
                              width *= max_size / height;
                              height = max_size;
                          }
                      }
                      canvas.width = width;
                      canvas.height = height;
    
                      canvas.getContext('2d').drawImage(image, 0, 0, width, height);
                      $(imageId).attr("src", canvas.toDataURL());
                      var resizedImage = createBlob(canvas.toDataURL());
                      var fileType = this.src.split(';')[0].split(':')[1];
                      var options = {
                            maxSizeMB: 1,
                            maxWidthOrHeight: imageMaxSize,
                            useWebWorker: true,
                            fileType: fileType,
                            initialQuality: 0.5
                      }
                  
                      imageCompression(resizedImage, options)
                            .then(function (compressedFile) {
                              fileData[realImageId] =  compressedFile;
                            })
                            .catch(function (error) {
                              console.log(error.message);
                            });
                    }
                  
              } 

              image.src=event.target.result;
            };

            reader.readAsDataURL(this.files[0]);
        });

        function createBlob(dataURL) {
          var BASE64_MARKER = ';base64,';
          if (dataURL.indexOf(BASE64_MARKER) == -1) {
            var parts = dataURL.split(',');
            var contentType = parts[0].split(':')[1];
            var raw = decodeURIComponent(parts[1]);
            return new Blob([raw], { type: contentType });
          }
          
          var parts = dataURL.split(BASE64_MARKER);
          var contentType = parts[0].split(':')[1];
          var raw = window.atob(parts[1]);
          var rawLength = raw.length;

          var uInt8Array = new Uint8Array(rawLength);

          for (var i = 0; i < rawLength; ++i) {
            uInt8Array[i] = raw.charCodeAt(i);
          }

          return new Blob([uInt8Array], { type: contentType });
        }

        var forms = document.getElementsByClassName('needs-validation');
        $("#formUpdate").on('submit', function (e) {
            $("#actionResultDiv").hide();
            if ($("#formUpdate").valid()) {
                var formData = new FormData(this);
                e.preventDefault(); // prevent the form's normal submission
                $("#actionResultDiv").show();
                $("#actionResultMessage").css('color', 'black');
                $("#actionResultMessage").text("Please wait...");
                Object.keys(fileData).forEach(function(fileKey) {
                    formData.set(fileKey, fileData[fileKey]);
                });
                
                addYamlEditorsToFormData(formData);
    
                let button = document.querySelector('button[type="submit"]');
                let formActionUrl = button.getAttribute('formaction');   
                
                $.ajax({
                    url: formActionUrl,
                    type: "POST",
                    dataType: "JSON",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response, status)
                    {
                        $("#actionResultDiv").show();
                        $("#actionResultMessage").css('color', 'green');
                        $("#actionResultMessage").text('Successfully Completed');

                        var operation = ($('#formUpdate').closest('.portal-entity-modal').attr('data-operation')
                            || 'Update'
                            || '').toString();
                        var successMessage = (typeof getPortalCrudSuccessMessage === 'function')
                            ? getPortalCrudSuccessMessage(operation)
                            : 'Operation completed successfully.';

                        if (typeof finishPortalCrudSuccess === 'function') {
                            finishPortalCrudSuccess(successMessage, operation);
                        } else {
                            if (typeof showPortalToast === 'function') {
                                showPortalToast(successMessage, 'success');
                            }
                            document.location.reload(true);
                        }
                    },
                    error: function (xhr, desc, error)
                    {
                        $("#actionResultMessage").css('color', 'red');
                        var fallbackMessage = error || desc || 'Request failed';
                        if (typeof handlePortalAjaxError === 'function') {
                            handlePortalAjaxError(xhr, {
                                reload: false,
                                fallbackMessage: fallbackMessage
                            });
                            var payload = (typeof getPortalAjaxErrorPayload === 'function')
                                ? getPortalAjaxErrorPayload(xhr)
                                : (xhr.responseJSON || null);
                            var msg = (payload && payload.message) ? payload.message : fallbackMessage;
                            $("#actionResultMessage").text(msg);
                            return;
                        }
                        if (xhr.responseJSON && xhr.responseJSON.redirectUrl) {
                            window.location = xhr.responseJSON.redirectUrl;
                            return;
                        }
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            ? xhr.responseJSON.message
                            : fallbackMessage;
                        $("#actionResultMessage").text(msg);
                        if (typeof showPortalToast === 'function') {
                            showPortalToast(msg, 'error');
                        }
                    }
                });  
            }
        })

        var validation = Array.prototype.filter.call(forms, function (form) {
            form.addEventListener('submit', function (event) {

                if (form.checkValidity() === false) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });

        setTimeout(function () {
            var validation = Array.prototype.filter.call(forms, function (form) {
                $("#actionResultDiv").hide();
                form.classList.add('was-validated');
            });
        }, 50);
        
        initSearchableSelects(document.getElementById('itemDetailsContainer') || document);
</script>