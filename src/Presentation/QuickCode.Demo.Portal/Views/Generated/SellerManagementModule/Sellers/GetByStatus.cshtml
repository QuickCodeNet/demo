@model QuickCode.Demo.Portal.Models.SellerManagementModule.SellerGetByStatusData
@{
    string title = "GetByStatus".SplitCamelCaseToString();
    TempData["Title"] = title;
}
<div class="container-fluid portal-query-page" IsPageAvailable="true">
    <form method="post" id="formList" data-portal-query="true" class="portal-entity-form portal-query-form" data-list-partial-url="/SellerManagementModuleSellers/Queries/GetByStatusPartial">
        @Html.AntiForgeryToken()
        <div class="portal-query-shell">
            <header class="portal-query-header">
                <div class="portal-query-header__copy">
                    <p class="portal-query-kicker">Live Report</p>
                    <h2 class="portal-query-title">@title</h2>
                    <p class="portal-query-lead">Set the parameters, run the report, then scan the rows below.</p>
                </div>
                <div class="portal-query-endpoint" title="API endpoint used by this report">
                    <span class="portal-query-endpoint__method">GET</span>
                    <code class="portal-query-endpoint__path">/api/seller-management-module/sellers/get-by-status/{sellerStatus}?pageNumber={pageNumber}&pageSize={pageSize}</code>
                </div>
            </header>

            <section class="portal-query-workspace" aria-label="Report parameters">
                <div class="portal-query-toolbar">
                    <div class="portal-query-params portal-entity-form">
<form-group>
	<select bc-label="Seller Status" class="form-select searchable-select" asp-for="SellerStatus" asp-items="Html.GetEnumSelectList<SellerManagementModuleApi.SellerStatus>()" data-placeholder="Search for Seller Status..."></select>
</form-group>
                    </div>
                    <div class="portal-query-actions">
                        <button type="submit" class="portal-query-run">
                            <i class="fas fa-play" aria-hidden="true"></i>
                            <span>Run Report</span>
                        </button>
                    </div>
                </div>
            </section>

            <section id="list-region" class="portal-list-region portal-query-results" aria-label="Report results">
                @await Html.PartialAsync("_GetByStatusTable", Model)
            </section>
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="HasRun" />
    </form>
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>
